# ============================================================================
# 페어플 (FairPle) — Cloud Run FastAPI 환경변수 템플릿 (server/.env.example)
# ============================================================================

# Supabase 설정 (PostgreSQL + Auth + Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI 설정
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# 관리자 이메일 화이트리스트 (쉼표로 구분, 대소문자 무시)
ADMIN_EMAILS=admin@example.com,manager@univ.ac.kr

# GAS -> Cloud Run 내부 프록시 검증용 시크릿
INTERNAL_PROXY_SECRET=fairple-gas-proxy-secret-2026

# 허용 CORS 오리진 (쉼표 구분)
ALLOWED_ORIGINS=https://script.google.com,https://script.googleusercontent.com,http://localhost:8080
